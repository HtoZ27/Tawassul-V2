{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HtoZ27/tawassul-v2/blob/main/tawassul.schema.json",
  "title": "Tawassul plugin configuration",
  "description": "Configuration accepted by the Tawassul plugin for OpenCode v2.",
  "type": "object",
  "properties": {
    "disabled": {
      "type": "boolean"
    },
    "team": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strictness": {
      "type": "string",
      "enum": [
        "relaxed",
        "normal",
        "strict"
      ]
    },
    "maxRecords": {
      "type": "number",
      "minimum": 10,
      "maximum": 10000
    },
    "maxHandoffs": {
      "type": "number",
      "minimum": 10,
      "maximum": 10000
    },
    "maxCompactItems": {
      "type": "number",
      "minimum": 5,
      "maximum": 200
    },
    "maxDynamicAgents": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "maxCallDepth": {
      "type": "number",
      "minimum": 1,
      "maximum": 20
    },
    "iterationBudgets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 1,
        "maximum": 10000
      }
    },
    "adaptiveBudgets": {
      "type": "boolean"
    },
    "projectScale": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "budgetStepPercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 200
    },
    "budgetCeilingFactor": {
      "type": "number",
      "minimum": 1,
      "maximum": 20
    },
    "budgetTiers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 1,
        "maximum": 10000
      }
    },
    "maxTotalTasks": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "suggestedHandoffs": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "stateFile": {
      "type": "string"
    },
    "configFile": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ]
    },
    "privacyGuardParanoid": {
      "type": "boolean"
    },
    "consensusBroker": {
      "type": "boolean"
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "deleted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agentEvaluation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minCompletionRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minContextLengthAvg": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "minTaskLengthAvg": {
          "type": "number",
          "minimum": 1,
          "maximum": 50
        },
        "minRecordsPerAgent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "agentModels": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "options": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "additionalProperties": false
            }
          },
          "capability": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "applyAgentMatcherSuggestion": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rateLimits": {
      "type": "object",
      "properties": {
        "burstMax": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "burstWindowMs": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        },
        "concurrentMax": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "slidingMax": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "slidingWindowMs": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        },
        "backToBurstAfterMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 60000
        },
        "apiRetryMax": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "apiRetryBaseMs": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        }
      },
      "additionalProperties": false
    },
    "freeLimit": {
      "type": "object",
      "properties": {
        "notice": {
          "type": "boolean"
        },
        "noRetry": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSwitches": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "cooldownMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 60000
        },
        "chains": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "stuckTimeoutMs": {
          "type": "number",
          "minimum": 1000,
          "maximum": 300000
        },
        "circuitBreakerThreshold": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "circuitBreakerResetMs": {
          "type": "number",
          "minimum": 1000,
          "maximum": 3600000
        }
      },
      "additionalProperties": false
    },
    "innovations": {
      "type": "object",
      "properties": {
        "contextHandoff": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "beta": {
              "type": "boolean"
            },
            "mandatory": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "beta": {
            "type": "boolean"
          },
          "mandatory": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
