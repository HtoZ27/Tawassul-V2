{
  "name": "tawassul-v2",
  "version": "0.1.0",
  "description": "Tawassul plugin for OpenCode v2 (Plugin API v2)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build-v2.mjs",
    "check:rules": "node scripts/check-v2-rules.mjs",
    "check:shared": "node scripts/check-shared-anchors.mjs",
    "verify": "npm run check:rules && npm run check:shared && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.3",
    "@types/node": "^24.0.0",
    "confbox": "^0.1.8",
    "typescript": "^5.6.0",
    "web-tree-sitter": "^0.26.13",
    "zod": "^4.1.8"
  }
}
